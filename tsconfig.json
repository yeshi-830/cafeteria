{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "useUnknownInCatchVariables": false
  },
  "include": ["backend/src/**/*.ts", "database/src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
